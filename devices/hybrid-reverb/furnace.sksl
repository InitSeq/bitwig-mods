// Hybrid Reverb: the meter bridge. Two VU meters (input and reverb) whose needles swing with the levels,
// a warm backlight that brightens with the reverb, and two jewel lamps: Freeze (red) and Shimmer (amber,
// with the Shimmer algorithm). The faces, scales and lamps are printed in the panel; this draws only
// what moves, over a transparent background. Geometry in display heights, as in make_panel.py.
// audioLow:    input level, wet level, decay (s), size factor (0.1 .. 2.5)
// audioMedium: damping 0..1, freeze 0/1, algorithm 0..4, time (s)
// audioHigh:   mod 0..1, shimmer 0..1, space decay (s), algorithm share 0..1
uniform float4 audioLow;
uniform float4 audioMedium;
uniform float4 audioHigh;

// 0..1 along the scale for a level: 0 VU = -14 dBFS, scale -20 .. +3 VU, linear in voltage
float vuPos(float lvl) {
    float vu = 20. * log(max(lvl, .0000001)) * .4342944819 + 14.;
    vu = clamp(vu, -23., 4.5);
    float lo = .1;
    float hi = 1.4125375;
    return (exp(vu * .1151292546) - lo) / (hi - lo);
}

float vuSeg(float2 p, float2 a, float2 b) {
    float2 pa = p - a;
    float2 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0., 1.);
    return length(pa - ba * h);
}

// one meter: returns rgb (premultiplied) and alpha of what it draws over the printed face
float4 vuMeter(float2 p, float fx, float fw, float lvl, float glow, float px) {
    float fy = .06;
    float fh = .62;
    float inFace = (p.x > fx && p.x < fx + fw && p.y > fy && p.y < fy + fh) ? 1. : 0.;
    float2 pivot = float2(fx + fw * .5, fy + fh + .15);
    float a = radians(-48. + 96. * clamp(vuPos(lvl), -.04, 1.04));
    float2 dir = float2(sin(a), -cos(a));
    float2 tip = pivot + dir * .56;
    float d = vuSeg(p, pivot, tip);
    float needle = clamp(1. - (d - .003) / px, 0., 1.) * inFace;
    float shadow = clamp(1. - (vuSeg(p - float2(.006, .008), pivot, tip) - .004) / (px * 3.), 0., 1.) * inFace * .25;
    float2 c = float2((p.x - (fx + fw * .5)) / fw, (p.y - (fy + fh * .75)) / fh);
    float light = exp(-dot(c, c) * 3.) * inFace * glow;
    float4 col = float4(1., .62, .22, 1.) * light * .35;
    col = col * (1. - shadow) + float4(0., 0., 0., shadow);
    col = col * (1. - needle) + float4(.08, .06, .05, 1.) * needle;
    return col;
}

float4 lamp(float2 p, float2 c, float on, float3 colr, float px) {
    float r = length(p - c);
    float core = clamp(1. - (r - .022) / px, 0., 1.) * on;
    float halo = exp(-r * r * 900.) * on * .6;
    float a = clamp(core + halo, 0., 1.);
    return float4(colr * a, a);
}

half4 main(float2 fragCoord) {
    float2 res = iResolution.xy;
    float px = 1. / res.y;
    float2 p = fragCoord / res.y;
    float mid = res.x / res.y * .5;
    float lvIn = audioLow.x;
    float lvWet = audioLow.y;
    float ice = audioMedium.y;
    float algo = audioMedium.z;
    float shim = audioHigh.y;
    float glow = .55 + .45 * clamp(vuPos(lvWet), 0., 1.);

    float4 col = vuMeter(p, .03, .84, lvIn, glow, px);
    float4 m2 = vuMeter(p, .892, .84, lvWet, glow, px);
    col = m2 + col * (1. - m2.a);
    float4 l1 = lamp(p, float2(mid - .12, .87), ice, float3(1., .18, .1), px);
    col = l1 + col * (1. - l1.a);
    float sh = (algo > 1.5 && algo < 2.5) ? (.25 + .75 * shim) : 0.;
    float4 l2 = lamp(p, float2(mid + .12, .87), sh, float3(1., .7, .2), px);
    col = l2 + col * (1. - l2.a);
    return half4(col);
}
