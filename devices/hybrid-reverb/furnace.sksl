// Hybrid Reverb: the furnace display. A decay graph in a kiln mouth: time across, level up (60 dB).
// The algorithm's tail is a filled line of fire, the space's a cream line over an amber haze, each as
// bright as its share of the blend. Embers rise with the level and sway with Mod; Damping cools the
// colour from white-hot to deep red; Freeze turns everything to ice; the Shimmer character adds sparks.
// audioLow:    input level, wet level, decay (s), size factor (0.1 .. 2.5)
// audioMedium: damping 0..1, freeze 0/1, algorithm 0..4, time (s)
// audioHigh:   mod 0..1, shimmer 0..1, space decay (s), algorithm share 0..1
uniform float4 audioLow;
uniform float4 audioMedium;
uniform float4 audioHigh;

float hrHash(float n) {
    return fract(sin(n * 12.9898) * 43758.5453);
}

// colour of heat: t 0 = deep red, 1 = white-hot; ice 1 = frozen blue
float3 hrHeat(float t, float ice) {
    float3 dark = float3(.45, .06, .02);
    float3 ember = float3(1., .42, .08);
    float3 hot = float3(1., .9, .62);
    float3 c = t < .5 ? mix(dark, ember, t * 2.) : mix(ember, hot, t * 2. - 1.);
    float3 cold = mix(float3(.12, .3, .55), float3(.8, .95, 1.), t);
    return mix(c, cold, ice);
}

// 0..1 from a level (linear), over 60 dB
float hrDb(float a) {
    return clamp(1. + log(max(a, .000001)) * .1448, 0., 1.);
}

float hrBand(float d, float w) {
    return clamp(1. - abs(d) / w, 0., 1.);
}

half4 main(float2 fragCoord) {
    float2 res = iResolution.xy;
    float2 uv = float2(fragCoord.x / res.x, 1. - fragCoord.y / res.y);
    float aspect = res.x / res.y;
    float lvIn = hrDb(audioLow.x);
    float lvWet = hrDb(audioLow.y);
    float decay = max(audioLow.z, .1);
    float size = audioLow.w;
    float damp = audioMedium.x;
    float ice = audioMedium.y;
    float algo = audioMedium.z;
    float time = audioMedium.w;
    float modA = audioHigh.x;
    float shim = audioHigh.y;
    float spaceDecay = max(audioHigh.z, .05);
    float share = audioHigh.w;
    float temp = 1. - .7 * damp;

    // the kiln mouth: an arch, wider with Size; dark brick outside, glowing chamber inside
    float span = .36 + .12 * clamp(size / 2.5, 0., 1.);
    float ax = (uv.x - .5) / span;
    float archY = .55 + .4 * sqrt(max(0., 1. - ax * ax));
    float inArch = (abs(ax) < 1. && uv.y < archY) ? 1. : 0.;
    float edge = min(clamp((archY - uv.y) * 18., 0., 1.), clamp((1. - abs(ax)) * span * 30., 0., 1.));
    float row = floor(uv.y * 9.);
    float brickX = fract(uv.x * 7. + .5 * fract(row * .5));
    float mortar = max(step(.9, fract(uv.y * 9.)), step(.94, brickX));
    float3 col = mix(float3(.075, .05, .04), float3(.03, .02, .018), mortar);
    col = col * (1. - .5 * inArch);
    float3 glowBed = hrHeat(temp * (.4 + .6 * lvWet), ice);
    col = col + glowBed * exp(-uv.y * 4.5) * (.25 + .9 * lvWet) * edge;
    col = col + hrHeat(.7 * temp, ice) * (1. - edge) * inArch * .0;
    col = col + hrHeat(.55 * temp, ice) * hrBand((archY - uv.y) * res.y, 2.5) * step(abs(ax), 1.) * (.4 + .5 * lvWet);

    // the decay graph inside the arch: time from the left of the arch to its right
    float x0 = .5 - span;
    float view = max(1., max(decay, spaceDecay) * 1.15);
    float t = (uv.x - x0) / (2. * span) * view;
    float onGraph = (t > 0. && uv.x < .5 + span) ? 1. : 0.;
    float top = .1 + .62 * (.45 + .55 * lvWet);
    float floorY = .1;
    float aShare = .2 + .8 * share;
    float sShare = .2 + .8 * (1. - share);

    // grid: a line every second, one every 12 dB
    float gx = hrBand(fract(t) * res.x / view * (2. * span), 1.) * onGraph;
    float gy = hrBand(fract((uv.y - floorY) / (top - floorY) * 5.) * res.y * (top - floorY) / 5., 1.) * step(floorY, uv.y) * step(uv.y, top);
    col = col + float3(.35, .16, .07) * max(gx, gy) * .22 * edge;

    // space: an amber haze under a cream line
    float envS = exp(-6.9 * t / spaceDecay);
    float yS = floorY + (top - floorY) * envS;
    col = col + float3(1., .6, .2) * step(uv.y, yS) * step(floorY, uv.y) * onGraph * .16 * envS * sShare * edge;
    col = col + mix(float3(1., .86, .62), float3(.75, .9, 1.), ice) * hrBand((uv.y - yS) * res.y, 1.6) * onGraph * sShare * .9 * edge;

    // algorithm: a filled line of fire
    float envA = exp(-6.9 * t / decay);
    float yA = floorY + (top - floorY) * envA;
    float under = step(uv.y, yA) * step(floorY, uv.y) * onGraph;
    float depth = clamp((yA - uv.y) / max(yA - floorY, .001), 0., 1.);
    col = col + hrHeat(temp * envA * (1. - .6 * depth), ice) * under * (.55 - .35 * depth) * aShare * edge;
    col = col + hrHeat(temp * (.6 + .4 * envA), ice) * hrBand((uv.y - yA) * res.y, 2.2) * onGraph * 1.3 * aShare * edge;
    col = col + hrHeat(temp * envA, ice) * exp(-abs(uv.y - yA) * res.y * .08) * onGraph * .35 * aShare * edge;

    // embers rising out of the bed: as many as the level, swaying with Mod; still in Freeze
    float speed = (.06 + .12 * temp) * (1. - ice);
    for (int i = 0; i < 70; i++) {
        float fi = float(i);
        float seed = hrHash(fi + 1.);
        float alive = step(fi / 70., .12 + .88 * max(lvIn, lvWet));
        float py = fract(seed + time * speed * (.5 + seed));
        float px = .5 + (hrHash(fi * 3.1) - .5) * 2. * span * .92;
        px = px + (.01 + modA * .04) * sin(time * (1. + seed * 2.) + fi * 1.7) * py;
        float2 d = float2((uv.x - px) * aspect, uv.y - (.08 + py * .85));
        float r = .004 + .007 * seed;
        float glow = exp(-dot(d, d) / (r * r)) * (1. - py) * alive;
        col = col + hrHeat(temp * (1. - py * .5), ice) * glow * 1.8 * edge;
    }

    // sparks of the Shimmer character, high in the arch
    float sparks = (algo > 1.5 && algo < 2.5) ? shim : 0.;
    for (int j = 0; j < 22; j++) {
        float fj = float(j);
        float2 p = float2(.5 + (hrHash(fj * 7.7) - .5) * 1.7 * span, .55 + .38 * hrHash(fj * 1.3));
        float tw = .5 + .5 * sin(time * (3. + 5. * hrHash(fj)) + fj);
        float2 d = float2((uv.x - p.x) * aspect, uv.y - p.y);
        col = col + float3(1., .95, .82) * exp(-dot(d, d) / .00003) * tw * sparks * (.3 + .7 * lvWet) * edge;
    }

    // frost round the edges in Freeze
    float2 c = float2(uv.x - .5, uv.y - .5);
    float frost = ice * clamp(dot(c, c) * 3.2 - .25, 0., 1.) * (.6 + .4 * hrHash(floor(uv.x * 160.) + floor(uv.y * 90.) * 161.));
    col = mix(col, float3(.78, .9, 1.), frost * .55);

    // wet level: a thin bar at the right
    float bar = step(.975, uv.x) * step(uv.x, .99) * step(uv.y, .06 + .88 * lvWet) * step(.06, uv.y);
    col = col + hrHeat(temp, ice) * bar * .9;

    col = col * (1. - .35 * dot(c, c));
    return half4(half3(col), 1.);
}
