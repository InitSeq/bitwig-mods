// Hybrid Reverb: the ripple display. Sound spreads from the centre as rings in a room whose walls are
// set by Size: cyan rings for the algorithm, magenta for the space, each fading over its own decay and
// as bright as its share of the blend. Walls light up where the rings reach them. Dust drifts with Mod;
// Freeze stops the rings and turns them to ice; the Shimmer character adds stars. A thin decay graph
// runs along the bottom.
// audioLow:    input level, wet level, decay (s), size factor (0.1 .. 2.5)
// audioMedium: damping 0..1, freeze 0/1, algorithm 0..4, time (s)
// audioHigh:   mod 0..1, shimmer 0..1, space decay (s), algorithm share 0..1
uniform float4 audioLow;
uniform float4 audioMedium;
uniform float4 audioHigh;

float nbHash(float n) {
    return fract(sin(n * 12.9898) * 43758.5453);
}

// 0..1 from a level (linear), over 60 dB
float nbDb(float a) {
    return clamp(1. + log(max(a, .000001)) * .1448, 0., 1.);
}

float nbLine(float d, float w) {
    return clamp(1. - abs(d) / w, 0., 1.);
}

// rings of one engine: n rings spaced in time, each fading with the decay; returns brightness
float nbRings(float r, float maxR, float t, float decay, float rate, float width) {
    float sum = 0.;
    for (int k = 0; k < 7; k++) {
        float age = fract(t * rate + float(k) / 7.);
        float radius = age * maxR;
        float seconds = age / rate;
        float fade = exp(-6.9 * seconds / max(decay, .05)) * (1. - age);
        sum = sum + (nbLine(r - radius, width) + .35 * exp(-abs(r - radius) / (width * 4.))) * fade;
    }
    return sum;
}

half4 main(float2 fragCoord) {
    float2 res = iResolution.xy;
    float2 p = float2(fragCoord.x - res.x * .5, res.y * .46 - fragCoord.y) / res.y;
    float lvIn = nbDb(audioLow.x);
    float lvWet = nbDb(audioLow.y);
    float decay = max(audioLow.z, .1);
    float size = clamp(audioLow.w / 2.5, 0., 1.);
    float damp = audioMedium.x;
    float ice = audioMedium.y;
    float algo = audioMedium.z;
    float time = audioMedium.w;
    float modA = audioHigh.x;
    float shim = audioHigh.y;
    float spaceDecay = max(audioHigh.z, .05);
    float share = audioHigh.w;

    float3 cyan = mix(float3(.25, .9, 1.), float3(.9, .97, 1.), ice);
    float3 magenta = mix(float3(1., .3, .72), float3(.82, .9, 1.), ice);
    float3 violet = float3(.55, .42, 1.);

    // background: deep blue-violet with a soft light in the middle
    float r = length(p);
    float3 col = float3(.012, .016, .04) + violet * .10 * exp(-r * r * 6.) + cyan * .04 * exp(-r * r * 2.);

    // the room: a rounded rectangle whose size follows Size; its walls glow with the wet level
    float2 room = float2(.55 + .55 * size, .26 + .14 * size);
    float2 q = abs(p) - room + float2(.06, .06);
    float wall = length(max(q, float2(0., 0.))) + min(max(q.x, q.y), 0.) - .06;
    float wallGlow = nbLine(wall, .006) * (.25 + .9 * lvWet) + exp(-abs(wall) * 60.) * .25 * lvWet;
    col = col + mix(violet, cyan, .5 + .5 * sin(atan(p.y, p.x) * 2. + time * .3)) * wallGlow;
    float inside = wall < 0. ? 1. : 0.;

    // grid on the floor of the room
    float grid = max(nbLine(fract(p.x * 10.) - .5, .02), nbLine(fract(p.y * 10.) - .5, .02));
    col = col + violet * grid * .035 * inside;

    // the rings: frozen in place with Freeze, a little blurred by Damping
    float t = time * (1. - ice) + ice * 7.3;
    float maxR = length(room) * 1.05;
    float wid = .008 + .01 * damp;
    float amp = .35 + .9 * max(lvWet, lvIn * .6);
    float ringA = nbRings(r, maxR, t, decay, .55, wid) * (.15 + .85 * share);
    float ringS = nbRings(r, maxR, t + .37, spaceDecay, .8, wid * 1.6) * (.15 + .85 * (1. - share));
    col = col + cyan * ringA * amp * 2. * inside;
    col = col + magenta * ringS * amp * 1.5 * inside;

    // the source in the middle, pulsing with the input
    col = col + mix(cyan, float3(1., 1., 1.), .5) * exp(-r * r * (900. - 600. * lvIn)) * (.4 + 1.2 * lvIn);

    // dust drifting with Mod
    for (int i = 0; i < 40; i++) {
        float fi = float(i);
        float2 d0 = float2(nbHash(fi) - .5, nbHash(fi + 9.1) - .5) * room * 2.;
        float ang = time * (.05 + .25 * modA) * (nbHash(fi + 3.) - .5) * 4. * (1. - ice);
        float2 dp = float2(d0.x * cos(ang) - d0.y * sin(ang), d0.x * sin(ang) + d0.y * cos(ang));
        float2 d = p - dp;
        float tw = .5 + .5 * sin(time * (1. + 3. * nbHash(fi + 5.)) + fi);
        col = col + mix(cyan, magenta, nbHash(fi + 2.)) * exp(-dot(d, d) * 40000.) * tw * (.25 + .75 * lvWet) * inside;
    }

    // stars of the Shimmer character
    float stars = (algo > 1.5 && algo < 2.5) ? shim : 0.;
    for (int j = 0; j < 18; j++) {
        float fj = float(j);
        float2 sp = float2(nbHash(fj * 7.7) - .5, nbHash(fj * 1.3) - .5) * room * 1.8;
        float tw = pow(.5 + .5 * sin(time * (2. + 4. * nbHash(fj)) + fj * 2.), 4.);
        float2 d = p - sp;
        float crs = exp(-abs(d.x) * 400.) * exp(-abs(d.y) * 60.) + exp(-abs(d.y) * 400.) * exp(-abs(d.x) * 60.);
        col = col + float3(1., .95, 1.) * (crs * .6 + exp(-dot(d, d) * 20000.)) * tw * stars * (.3 + .7 * lvWet);
    }

    // the decay graph along the bottom: both engines, 0..60 dB over the longer decay
    float2 uv = float2(fragCoord.x / res.x, 1. - fragCoord.y / res.y);
    float view = max(1., max(decay, spaceDecay) * 1.1);
    float gt = (uv.x - .06) / .88 * view;
    float gh = .085;
    float onG = (gt > 0. && uv.x < .94) ? 1. : 0.;
    float ya = .035 + gh * exp(-6.9 * gt / decay);
    float ys = .035 + gh * exp(-6.9 * gt / spaceDecay);
    col = col + cyan * nbLine((uv.y - ya) * res.y, 1.2) * onG * (.3 + .7 * share);
    col = col + magenta * nbLine((uv.y - ys) * res.y, 1.2) * onG * (.3 + .7 * (1. - share));
    col = col + float3(1., 1., 1.) * nbLine((uv.y - .035) * res.y, .6) * onG * .12;

    // frost in Freeze
    float frost = ice * clamp(r * r * 1.6 - .1, 0., 1.) * (.5 + .5 * nbHash(floor(fragCoord.x * .5) * 7. + floor(fragCoord.y * .5) * 131.));
    col = mix(col, float3(.85, .93, 1.), frost * .35);

    return half4(half3(col), 1.);
}
