{
  "manifest_version": 2,
  "mod": {
    "id": "note-generator",
    "name": "Piano Roll: Note Generator",
    "area": "Piano Roll",
    "version": "0.2.0-dev.1",
    "author": "Coldforge",
    "description": "Generates chords or a melody in the project's key, laid out in a form such as A A A B, from a block in the Inspector. Works on the whole clip or on the selected notes' range. See and hear the result before you apply it",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "macos",
    "architecture": "universal"
  },
  "requires": [
    {
      "id": "piano-roll-framework",
      "min_version": "0.2.0-dev.1"
    },
    {
      "id": "inspector-composition-framework",
      "min_version": "0.3.0-dev.1"
    },
    {
      "id": "notifications-framework",
      "min_version": "0.3.0-dev.1"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "registrations": [
    {
      "id": "inspector",
      "consumer": "inspector-composition-framework",
      "descriptor": "inspector-blocks.properties",
      "jar": "helper.jar"
    }
  ],
  "targets": {
    "aNi.Gef": {
      "kind": "method",
      "owner": "aNi",
      "name": "Gef",
      "descriptor": "(LHSH;Lbke;LbaN;)V"
    }
  },
  "hooks": [
    {
      "id": "detail-editor-set-up",
      "target": "aNi.Gef",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "setUp",
        "descriptor": "(LaNi;)V",
        "args": [
          "this"
        ]
      }
    }
  ],
  "helper": {
    "jar": "helper.jar",
    "class": "ch.coldforge.notegen.DetailEditor"
  }
}