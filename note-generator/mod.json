{
  "manifest_version": 2,
  "mod": {
    "id": "note-generator",
    "name": "Piano Roll: Note Generator",
    "area": "Piano Roll",
    "version": "0.5.0-dev.1",
    "author": "Coldforge",
    "description": "Generates chords or a melody in the project's key, laid out in a form such as A A A B. Make a time selection in a clip's note editor (or none, for the whole clip), then choose Generate Notes\u2026 from the right-click menu or the button beside the piano keys, and pick the options in a dialog",
    "documentation": "readme"
  },
  "built_against": {
    "bitwig_version": "6.1.7",
    "platform": "macos",
    "architecture": "universal"
  },
  "requires": [
    {
      "id": "piano-roll-framework",
      "min_version": "0.2.0-dev.1"
    },
    {
      "id": "action-menu-composition-framework",
      "min_version": "0.9.0-dev.4"
    },
    {
      "id": "inspector-composition-framework",
      "min_version": "0.3.0-dev.1"
    },
    {
      "id": "notifications-framework",
      "min_version": "0.3.0-dev.1"
    }
  ],
  "resources": {
    "readme": {
      "kind": "file",
      "path": "README.md",
      "media_type": "text/markdown"
    }
  },
  "registrations": [
    {
      "id": "actions",
      "consumer": "action-menu-composition-framework",
      "descriptor": "actions.properties",
      "jar": "helper.jar"
    }
  ],
  "targets": {
    "aNi.Gef": {
      "kind": "method",
      "owner": "aNi",
      "name": "Gef",
      "descriptor": "(LHSH;Lbke;LbaN;)V"
    },
    "QCB.unz": {
      "kind": "method",
      "owner": "QCB",
      "name": "unz",
      "descriptor": "(D)V"
    },
    "QCB.Anf": {
      "kind": "method",
      "owner": "QCB",
      "name": "Anf",
      "descriptor": "(D)V"
    },
    "com.bitwig.flt.widget.core.timeline.WRA.beI": {
      "kind": "method",
      "owner": "com/bitwig/flt/widget/core/timeline/WRA",
      "name": "beI",
      "descriptor": "(Lbke;LJtD;)LdwF;"
    },
    "aJI.Anf": {
      "kind": "field",
      "owner": "aJI",
      "name": "Anf",
      "descriptor": "LaNi;"
    },
    "dBY.beI": {
      "kind": "method",
      "owner": "dBY",
      "name": "beI",
      "descriptor": "(LejM;)V"
    },
    "dvv.init": {
      "kind": "method",
      "owner": "dvv",
      "name": "<init>",
      "descriptor": "()V"
    }
  },
  "hooks": [
    {
      "id": "detail-editor-set-up",
      "target": "aNi.Gef",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "setUp",
        "descriptor": "(LaNi;)V",
        "args": [
          "this"
        ]
      }
    },
    {
      "id": "time-selection-start",
      "target": "QCB.unz",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "timeStart",
        "descriptor": "(LQCB;)V",
        "args": [
          "this"
        ]
      }
    },
    {
      "id": "time-selection-end",
      "target": "QCB.Anf",
      "transform": "INSERT_AT_ENTRY",
      "bridge": {
        "method": "timeEnd",
        "descriptor": "(LQCB;)V",
        "args": [
          "this"
        ]
      }
    },
    {
      "id": "mode-strip-button",
      "target": "com.bitwig.flt.widget.core.timeline.WRA.beI",
      "transform": "WRAP_OBJECT_RETURN",
      "bridge": {
        "method": "addButton",
        "descriptor": "(LdwF;)LdwF;",
        "args": []
      }
    }
  ],
  "helper": {
    "jar": "helper.jar",
    "class": "ch.coldforge.notegen.DetailEditor"
  },
  "opens": [
    "aJI.Anf",
    "dBY.beI",
    "dvv.init"
  ]
}